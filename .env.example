# Database - Supabase PostgreSQL
DATABASE_URL="postgresql://user:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://user:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase Storage - PDF Configuration
# احصل على هذه المعلومات من: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...YOUR_SERVICE_ROLE_KEY

# API Security - PDF Download Protection
# استخدم مفتاح عشوائي قوي، مثلاً: openssl rand -base64 32
PDF_DOWNLOAD_API_KEY=your_secret_api_key_here_at_least_32_characters
NEXT_PUBLIC_PDF_API_KEY=your_secret_api_key_here_at_least_32_characters

# ملاحظات الأمان:
# 1. PDF_DOWNLOAD_API_KEY: يُستخدم على الخادم فقط (سري)
# 2. NEXT_PUBLIC_PDF_API_KEY: يُرسل من العميل (نفس القيمة لكن علني)
# 3. استخدم قيماً قوية وعشوائية لكلا المفتاحين
# 4. غيّر المفاتيح دورياً في الإنتاج
